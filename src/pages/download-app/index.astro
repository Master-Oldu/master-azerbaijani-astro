---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseHead 
  title="Master Azerbaijani App"
  description="Download Master Azerbaijani, a structured Azerbaijani language learning app for heritage families, beginners, and curious learners. Now available on the App Store and Google Play."
/>

<Header />

<main class="page-container about-page">

<div style="text-align:center;">

  <!-- Flag -->
  <div style="font-size:4rem; margin-bottom:20px;">🇦🇿</div>

  <!-- Title -->
  <h1>Master Azerbaijani</h1>

  <!-- Subtitle -->
  <p
    style="
      font-size:1.5rem;
      opacity:0.9;
      margin:0 auto 60px;
      text-shadow:2px 2px 4px rgba(0,0,0,0.3);
      max-width:900px;
    "
  >
    Connect with your heritage. Bridge generations. Build belonging.
  </p>

  <!-- Learning Journey Box -->
  <section style="max-width:720px; margin:0 auto 40px; padding:24px 26px; border-radius:14px; background:linear-gradient(135deg, rgba(255,255,255,0.25), rgba(255,255,255,0.1)); border:1px solid rgba(255,255,255,0.25); backdrop-filter:blur(10px); box-shadow:0 10px 30px rgba(0,0,0,0.2); text-align:center;">

    <h2 style="margin-bottom:20px; font-size:1.85rem; font-weight:700; letter-spacing:0.3px;">
      Your Azerbaijani Learning Journey Starts Here
    </h2>

    <div style="display:flex; flex-direction:column; gap:14px; align-items:center;">
      <div>Start learning free with Module 1</div>
      <div>Explore vocabulary from every module for free</div>
      <div>Progress through structured learning modules</div>
      <div>Build practical language skills step by step</div>
    </div>

  </section>

  <!-- Download Buttons -->
  <div class="download-buttons" id="app-download-buttons">
    <a
      href="https://apps.apple.com/us/app/master-azerbaijani/id6760097533"
      target="_blank"
      rel="noopener noreferrer"
      class="download-app-button"
    >
      Download on the App Store
    </a>

    <a
      href="https://play.google.com/store/apps/details?id=com.masterazerbaijani.app"
      target="_blank"
      rel="noopener noreferrer"
      class="download-app-button"
    >
      Get it on Google Play
    </a>
  </div>

  <!-- Apple App Store Reviews Link -->
  <div class="app-review-area">
    <a
      href="https://apps.apple.com/us/app/master-azerbaijani/id6760097533?see-all=reviews&amp;platform=iphone"
      target="_blank"
      rel="noopener noreferrer"
      class="app-review-link"
    >
      Read App Store Reviews
    </a>
  </div>

</div>

<!-- Screenshots -->
<section style="margin:60px 0; text-align:center;">

  <h2 style="margin-bottom:25px;">Inside the App</h2>

  <div
    style="
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:20px;
      max-width:900px;
      margin:auto;
    "
  >

    <div>
      <img src="/images/app-screenshot-1.png" style="width:100%; border-radius:10px;" />
      <p style="margin-top:8px;">Alphabet foundations and pronunciation</p>
    </div>

    <div>
      <img src="/images/app-screenshot-2.png" style="width:100%; border-radius:10px;" />
      <p style="margin-top:8px;">Vocabulary with native audio guidance</p>
    </div>

    <div>
      <img src="/images/app-screenshot-3.png" style="width:100%; border-radius:10px;" />
      <p style="margin-top:8px;">Structured lessons that build real understanding</p>
    </div>

  </div>

</section>

<!-- Features -->
<section style="margin:60px auto; max-width:720px; padding:24px 26px; border-radius:14px; background:linear-gradient(135deg, rgba(255,255,255,0.25), rgba(255,255,255,0.1)); border:1px solid rgba(255,255,255,0.25); backdrop-filter:blur(10px); box-shadow:0 10px 30px rgba(0,0,0,0.2); text-align:center;">

  <h2 style="margin-bottom:24px;">What the App Includes</h2>

  <div style="max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap:16px; align-items:flex-start; text-align:left;">
    <div style="display:flex; align-items:flex-start; gap:12px;">
      <span style="color:#FA7239; font-weight:700; line-height:1.4;">✓</span>
      <span>Structured modules that guide you step-by-step</span>
    </div>
    <div style="display:flex; align-items:flex-start; gap:12px;">
      <span style="color:#FA7239; font-weight:700; line-height:1.4;">✓</span>
      <span>Vocabulary with pronunciation guidance</span>
    </div>
    <div style="display:flex; align-items:flex-start; gap:12px;">
      <span style="color:#FA7239; font-weight:700; line-height:1.4;">✓</span>
      <span>Cultural insights beyond just words</span>
    </div>
    <div style="display:flex; align-items:flex-start; gap:12px;">
      <span style="color:#FA7239; font-weight:700; line-height:1.4;">✓</span>
      <span>Practical phrases for real conversations</span>
    </div>
    <div style="display:flex; align-items:flex-start; gap:12px;">
      <span style="color:#FA7239; font-weight:700; line-height:1.4;">✓</span>
      <span>Designed for heritage learners and families abroad</span>
    </div>
  </div>

</section>

<!-- Built with Purpose -->
<section style="margin:60px auto; max-width:720px; padding:24px 26px; border-radius:14px; background:linear-gradient(135deg, rgba(255,255,255,0.18), rgba(255,255,255,0.08)); border:1px solid rgba(255,255,255,0.2); backdrop-filter:blur(8px); text-align:left;">

  <h2 style="margin-bottom:14px; text-align:center;">Built with Purpose</h2>

  <p style="margin-bottom:12px;">
    Master Azerbaijani is independently developed with one goal: making the Azerbaijani language more accessible to learners around the world.
  </p>

  <p style="margin-bottom:12px;">
    Each module follows a structured learning path, combining clear explanations, practical vocabulary, and lessons designed to build understanding and confidence.
  </p>

  <p style="opacity:0.85;">
    The app continues to evolve through new content, expanding native Azerbaijani audio, and feedback from learners.
  </p>

</section>

<!-- Newsletter -->
<section style="margin:60px auto; max-width:720px; padding:24px 26px; border-radius:14px; background:linear-gradient(135deg, rgba(255,255,255,0.25), rgba(255,255,255,0.1)); border:1px solid rgba(255,255,255,0.25); backdrop-filter:blur(10px); box-shadow:0 10px 30px rgba(0,0,0,0.2); text-align:center;">

  <h2 style="margin-bottom:12px;">Learn Beyond the App</h2>

  <p style="margin-bottom:15px;">
    Get new Azerbaijani language tips, cultural insights, and real-life learning content every 10 days.
  </p>

  <p style="margin-bottom:25px;">
    Join the newsletter to stay consistent and keep learning.
  </p>

  <a
    href="https://docs.google.com/forms/d/e/1FAIpQLSchAl_aV-b9vF2ah5HPzdfD8OiWQ-J4uwtu_VLt7WfP_tGR3A/viewform"
    target="_blank"
    rel="noopener noreferrer"
    class="download-app-button subscribe-button"
  >
    Subscribe to Updates
  </a>

  <p style="margin-top:12px; font-size:0.9rem; opacity:0.8;">
    Takes 20 seconds. No spam.
  </p>

</section>

<!-- What's Next -->
<section style="
  margin:60px auto;
  max-width:720px;
  padding:24px 26px 30px;
  border-radius:14px;
  background:linear-gradient(135deg, rgba(255,255,255,0.25), rgba(255,255,255,0.1));
  border:1px solid rgba(255,255,255,0.25);
  backdrop-filter:blur(10px);
  box-shadow:0 10px 30px rgba(0,0,0,0.2);
  text-align:center;
">

  <h2 style="margin-bottom:24px;">What’s Next</h2>

  <div style="
    display:grid;
    grid-template-columns:170px 1fr;
    column-gap:18px;
    row-gap:16px;
    max-width:640px;
    margin:0 auto;
    align-items:start;
  ">

    <div style="font-weight:600; color:#FA7239; text-align:right;">
      Ongoing
    </div>
    <div style="text-align:left;">
      Expanding native Azerbaijani audio across lessons
    </div>

    <div style="font-weight:600; color:#FA7239; text-align:right;">
      March 2027
    </div>
    <div style="text-align:left;">
      Five additional modules planned to complete the learning path
    </div>

    <div style="font-weight:600; color:#FA7239; text-align:right;">
      2027 Focus
    </div>
    <div style="text-align:left;">
      Refining lessons, strengthening practice, and improving the overall experience for independent Azerbaijani learners
    </div>

  </div>

</section>

<!-- Contact -->
<div style="margin-top:50px; text-align:center;">
  Questions or feedback?<br />
  <a href="mailto:hello@masterazerbaijani.com" style="color:#FA7239; font-weight:600; text-decoration:none;">
    hello@masterazerbaijani.com
  </a>
</div>
</main>

<Footer />

<!-- Page-specific styling for download buttons and review link -->
<style>
  #app-download-buttons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    width: 100%;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    align-items: stretch;
  }

  #app-download-buttons > .download-app-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    height: 76px;
    min-height: 76px;
    box-sizing: border-box;
    margin: 0;
    text-align: center;
  }

  .app-review-area {
    width: 100%;
    max-width: 720px;
    margin: 20px auto 0;
    text-align: center;
  }

  .app-review-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    height: 76px;
    min-height: 76px;
    box-sizing: border-box;
    padding: 12px 26px;
    border: 1px solid #FA7239;
    border-radius: 12px;
    background: rgba(255,255,255,0.06);
    color: #f5f5f5;
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .app-review-link:hover {
    background: rgba(250,114,57,0.15);
    color: #ffffff;
  }

  .app-review-link:focus-visible {
    outline: 2px solid #FA7239;
    outline-offset: 5px;
    border-radius: 12px;
  }

  @media (max-width: 1024px), (any-pointer: coarse) {
    #app-download-buttons {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #app-download-buttons > .download-app-button,
    .app-review-link {
      height: 90px;
      min-height: 90px;
    }

    .app-review-link {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 640px) {
    section[style*="grid-template-columns:170px 1fr"] div[style*="text-align:right"] {
      text-align: left !important;
    }

    section[style*="grid-template-columns:170px 1fr"] > div {
      grid-template-columns: 1fr !important;
    }
  }
</style>
