---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const demoPreview = import.meta.env.DEV && import.meta.env.PUBLIC_DASHBOARD_DEMO !== 'false';
---

<DashboardLayout
  title="Overview"
  section="overview"
  description={
    demoPreview
      ? 'Current access and unresolved purchases stay fixed. The reporting period changes registrations and recorded completions.'
      : 'Current counts stay separate from the reporting period. Latest registrations and purchases requiring review load after the server confirms an administrator.'
  }
>
  <p class="loading">{demoPreview ? 'Loading demonstration data…' : 'Loading…'}</p>
</DashboardLayout>

<script>
  import { startDashboard } from '../../dashboard/gate';

  const root = document.querySelector('#dashboard-root');
  if (root instanceof HTMLElement) {
    void startDashboard(root, 'overview');
  }
</script>
