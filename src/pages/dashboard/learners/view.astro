---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const demoPreview = import.meta.env.DEV && import.meta.env.PUBLIC_DASHBOARD_DEMO !== 'false';
---

<DashboardLayout
  title="Learner details"
  section="learners"
  description={
    demoPreview
      ? 'Account, lesson progression, learning history, entitlements, and purchase records.'
      : 'Sign in with your existing Master Azerbaijani account. Learner records stay closed until the server confirms an administrator.'
  }
>
  <p class="loading">{demoPreview ? 'Loading demonstration data…' : 'Loading…'}</p>
</DashboardLayout>

<script>
  import { startDashboard } from '../../../dashboard/gate';

  const root = document.querySelector('#dashboard-root');
  if (root instanceof HTMLElement) {
    void startDashboard(root, 'learner');
  }
</script>
