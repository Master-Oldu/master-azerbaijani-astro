---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const demoPreview = import.meta.env.DEV && import.meta.env.PUBLIC_DASHBOARD_DEMO !== 'false';
---

<DashboardLayout
  title="Learners"
  section="learners"
  description={
    demoPreview
      ? 'Search demonstration accounts, then open a learner for progress and purchases.'
      : 'Search by saved name or email. The directory is one page at a time. Lesson history and purchases are not included.'
  }
>
  <p class="loading">{demoPreview ? 'Loading demonstration data…' : 'Loading…'}</p>
</DashboardLayout>

<script>
  import { startDashboard } from '../../../dashboard/gate';

  const root = document.querySelector('#dashboard-root');
  if (root instanceof HTMLElement) {
    void startDashboard(root, 'learners');
  }
</script>
