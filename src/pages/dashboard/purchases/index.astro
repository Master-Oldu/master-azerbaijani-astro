---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const demoPreview = import.meta.env.DEV && import.meta.env.PUBLIC_DASHBOARD_DEMO !== 'false';
---

<DashboardLayout
  title="Purchases"
  section="purchases"
  description={
    demoPreview
      ? 'Store transactions, payment classification, grants, entitlement status, and ownership. Counts are records, not customer accounts.'
      : 'Entitlement lineages and grants load only after the server confirms an administrator. Counts are records, not payments or customer accounts.'
  }
>
  <p class="loading">{demoPreview ? 'Loading demonstration data…' : 'Loading…'}</p>
</DashboardLayout>

<script>
  import { startDashboard } from '../../../dashboard/gate';

  const root = document.querySelector('#dashboard-root');
  if (root instanceof HTMLElement) {
    void startDashboard(root, 'purchases');
  }
</script>
